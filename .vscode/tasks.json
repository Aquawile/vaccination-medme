{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Keep in sync with GitHub",
      "type": "shell",
      "command": "bash scripts/watch.sh",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activelyWatching": true,
          "beginsPattern": ".",
          "endsPattern": "."
        }
      },
      "isBackground": true
    }
  ]
}